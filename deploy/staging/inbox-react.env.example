# Copy this file and the acceptance JSON into an ignored private directory.
# Keep the copied environment file at mode 0600. Replace every blank/placeholder.
PUBLIC_ORIGIN=https://staging.inbox.example.com
FYRLET_ENDPOINT=https://api-staging.example.com
FYRLET_PROJECT_ID=
FYRLET_SERVICE_KEY=
ALLOW_INSECURE_OIDC=0

# Public PKCE clients omit clientSecret. A confidential client may add its secret
# inside the corresponding JSON object. Keep issuer strings exact.
OIDC_PROVIDERS=[{"name":"first","label":"First staging IdP","issuer":"https://first-id.example.com","clientId":"replace-with-first-client-id"},{"name":"second","label":"Second staging IdP","issuer":"https://second-id.example.com","clientId":"replace-with-second-client-id"}]

# Every direct host needs the same origin/project/provider identity settings and
# the same shared-store namespace/key. Use direct or session-affine PostgreSQL,
# never transaction/statement pooling for host advisory locks.
HOST_INSTANCES=2
HOST_STORE_DATABASE_URL=
HOST_STORE_KEY=
HOST_STORE_NAMESPACE=inbox-staging

# These are referenced by the browser steps in acceptance.json. They can instead
# be injected into the runner process by a secret manager. Never put them in JSON.
STAGING_PRIMARY_USERNAME=
STAGING_PRIMARY_PASSWORD=
STAGING_SECONDARY_USERNAME=
STAGING_SECONDARY_PASSWORD=

# Optional storage-state alternative (replace steps for the relevant account):
# STAGING_PRIMARY_STATE=./primary-state.json
# STAGING_SECONDARY_STATE=./secondary-state.json
