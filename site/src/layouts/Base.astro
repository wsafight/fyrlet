---
import "../styles/global.css";
import { base, gh, href, ui, type Lang } from "../i18n";
interface Props { title: string; description: string; lang: Lang; alt: string }
const { title, description, lang, alt } = Astro.props;
const t = ui[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === "zh" ? "en" : "zh-CN"} href={new URL(alt, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href(lang, "/")}>
          <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#c2410c"/><path d="M16 5c1 5 6 7 6 13a6 6 0 0 1-12 0c0-3 2-4 3-7 1 1 2 2 2 4 1-3 1-6 1-10z" fill="#fff"/></svg>
          Fyrlet
        </a>
        <nav class="nav" aria-label={t.mainNav}>
          <a class="hide-sm" href={href(lang, "/#features")}>{t.features}</a>
          <a class="hide-sm" href={href(lang, "/#examples")}>{t.examples}</a>
          <a href={href(lang, "/docs/tutorial/")}>{t.docs}</a>
          <a class="gh" href={gh}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.34.66.07-.52.28-.87.51-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0z"/></svg><span class="hide-sm">{t.github}</span></a>
          <a class="lang" href={alt} hreflang={lang === "zh" ? "en" : "zh-CN"} lang={lang === "zh" ? "en" : "zh-CN"}>{t.other}</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <span>{t.rights}</span>
        <nav aria-label={t.footerNav}><a href={href(lang, "/docs/tutorial/")}>{t.docs}</a><a href={gh}>GitHub</a><a href={href(lang, "/#examples")}>{t.examples}</a></nav>
      </div>
    </footer>
  </body>
</html>
