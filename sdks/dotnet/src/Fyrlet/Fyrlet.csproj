<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>Fyrlet</AssemblyName>
    <RootNamespace>Fyrlet</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Fyrlet client for typed operations and recoverable Phoenix subscriptions</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Fyrlet.Tests" />
  </ItemGroup>
</Project>
