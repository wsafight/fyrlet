{
  "name": "@fyrlet/client",
  "version": "0.1.0",
  "description": "Fyrlet client for typed operations and recoverable Phoenix subscriptions",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsafight/fyrlet.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://github.com/wsafight/fyrlet/tree/main/sdks/typescript#readme",
  "bugs": "https://github.com/wsafight/fyrlet/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./example-contract": {
      "types": "./dist/generated/app.d.ts",
      "import": "./dist/generated/app.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs ../../priv/contract.json src/generated/app.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "npm run build && node --test test/unit.test.mjs test/unit/*.test.mjs",
    "test:coverage": "npm run build && node --experimental-test-coverage --test --test-coverage-include=\"dist/**/*.js\" test/unit.test.mjs test/unit/*.test.mjs",
    "test:integration": "npm run build && node --test test/integration.test.mjs"
  },
  "dependencies": {
    "phoenix": "1.8.16"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/phoenix": "1.6.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
